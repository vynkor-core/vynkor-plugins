{
  "plugin_id": "sync",
  "version": "0.1.0",
  "permissions": ["PERMISSION_STORAGE", "PERMISSION_EVENT_PUBLISH"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "sync",
  "events": ["sync.delta"],
  "files": ["sync", "plugin.json"],
  "actions": [
    {
      "name": "sync_get_snapshot",
      "description": "Return the whole synced state as one snapshot. Read-only.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Takes no params; returns the full state map and current version."
      },
      "output": {
        "type": "object",
        "properties": {
          "version": { "type": "integer", "description": "Current store version." },
          "state": {
            "type": "object",
            "additionalProperties": true,
            "description": "key -> decoded JSON value."
          }
        },
        "required": ["version", "state"],
        "additionalProperties": false
      }
    },
    {
      "name": "sync_get",
      "description": "Read one synced value by key. Read-only.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "description": "State key." }
        },
        "required": ["key"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": { "type": "boolean" },
          "value": { "description": "Decoded JSON value when found, null otherwise." }
        },
        "required": ["found"],
        "additionalProperties": true
      }
    },
    {
      "name": "sync_set",
      "description": "Store an arbitrary JSON value under a key, replacing whatever was there. The change propagates to every synced client.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "description": "Arbitrary JSON value; stored as JSON text, capped at SYNC_PLUGIN_MAX_VALUE_BYTES." }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "version": { "type": "integer", "description": "Store version after the mutation." }
        },
        "required": ["ok", "version"],
        "additionalProperties": false
      }
    },
    {
      "name": "sync_del",
      "description": "Delete a key from synced state. Irreversible, and the deletion propagates to every synced client.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {
          "key": { "type": "string" }
        },
        "required": ["key"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": { "type": "boolean", "description": "Whether the key existed and was removed." },
          "version": { "type": "integer", "description": "Store version after the mutation (unchanged when deleted is false)." }
        },
        "required": ["deleted", "version"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "SYNC_PLUGIN_DATA_DIR": {
        "type": "string",
        "description": "Directory holding the sync.db store. Required."
      },
      "SYNC_PLUGIN_POOL_SIZE": {
        "type": "integer",
        "minimum": 1,
        "default": 4,
        "description": "Connections in the SQLite pool."
      },
      "SYNC_PLUGIN_BUSY_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 0,
        "default": 5000,
        "description": "SQLite busy timeout."
      },
      "SYNC_PLUGIN_MAX_VALUE_BYTES": {
        "type": "integer",
        "minimum": 1,
        "default": 1048576,
        "description": "sync_set value size cap. Oversized values are rejected, never truncated."
      },
      "SYNC_PLUGIN_MAX_RESPONSE_BYTES": {
        "type": "integer",
        "minimum": 1,
        "default": 4194304,
        "description": "sync_get_snapshot result size cap."
      },
      "SYNC_PLUGIN_MAX_DB_BYTES": {
        "type": "integer",
        "minimum": 0,
        "default": 268435456,
        "description": "Hard disk quota enforced via PRAGMA max_page_count. 0 disables."
      },
      "SYNC_PLUGIN_HEARTBEAT_TTL_SECS": {
        "type": "integer",
        "minimum": 0,
        "default": 300,
        "description": "Heartbeat row TTL in seconds; 0 disables pruning."
      }
    },
    "required": ["SYNC_PLUGIN_DATA_DIR"],
    "additionalProperties": true
  }
}
