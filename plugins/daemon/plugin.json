{
  "plugin_id": "daemon",
  "version": "0.1.2",
  "permissions": [
    "PERMISSION_AUDIO",
    "PERMISSION_EVENT_PUBLISH"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "daemon",
  "events": [],
  "files": [
    "daemon",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "daemon_enable",
      "description": "Turn the always-listening voice daemon on: it starts taking mic input and answering aloud on its own until disabled.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "daemon_disable",
      "description": "Turn the voice daemon off; the mic stops being consumed and nothing is spoken until it is enabled again.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "daemon_status",
      "description": "Report whether the voice daemon is enabled and what it is currently doing. Read-only.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether the background listen loop is on."
          },
          "busy": {
            "type": "boolean",
            "description": "True while a voice turn is running."
          },
          "turns_completed": {
            "type": "integer",
            "minimum": 0,
            "description": "Voice turns finished since process start."
          },
          "last_turn": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "transcript": {
                    "type": "string"
                  },
                  "answer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "duration_ms": {
                    "type": "integer"
                  }
                }
              }
            ],
            "description": "Result of the most recent voice turn, or null before the first one."
          }
        },
        "required": [
          "enabled",
          "busy",
          "turns_completed",
          "last_turn"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "daemon_turn",
      "description": "Run one full daemon turn — listen, transcribe, answer, speak. With text supplied, skips the mic/stt stage and uses that text as the prompt. Speaks the answer out loud through the local speakers.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Skip the mic/stt listen stage and use this text as the prompt instead."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "silent",
              "error"
            ],
            "description": "answered = agent replied and the answer was spoken; silent = empty transcript; error = a stage failed (see error)."
          },
          "transcript": {
            "type": "string",
            "description": "The prompt this turn used (stt transcript, or the text param when given)."
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Agent final_answer when status is answered."
          },
          "goal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "goal_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stage failure detail when status is error."
          },
          "spoken": {
            "type": "boolean",
            "description": "True when audio reached sound_play."
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "transcript",
          "answer",
          "spoken",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "daemon_say",
      "description": "Speak text aloud through tts + sound right now. Audible to anyone in the room.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize and play through tts + sound."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "spoken": {
            "type": "boolean",
            "const": true
          },
          "clip_id": {
            "type": "string",
            "description": "sound_play clip handle (for sound_stop)."
          },
          "player": {
            "type": "string",
            "description": "Host player binary sound spawned."
          },
          "format": {
            "type": "string",
            "description": "Audio format synthesized by tts."
          }
        },
        "required": [
          "spoken",
          "clip_id",
          "player",
          "format"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "daemon_ask",
      "description": "Put a prompt through the agent's goal loop and speak the answer aloud, returning it as well. The goal loop may call other tools, so this inherits their effects.",
      "risk": "high",
      "input": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Prompt for the agent's goal loop; the answer is spoken aloud and returned."
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Agent final_answer (null unless goal_status is completed)."
          },
          "goal_id": {
            "type": "string"
          },
          "goal_status": {
            "type": "string",
            "enum": [
              "completed",
              "needs_confirmation",
              "declined",
              "max_steps_reached",
              "error"
            ]
          },
          "spoken": {
            "type": "boolean"
          }
        },
        "required": [
          "answer",
          "goal_id",
          "goal_status",
          "spoken"
        ],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "DAEMON_PLUGIN_ENABLED": {
        "type": "boolean",
        "description": "Start with the background listen loop on (default false — enable via daemon_enable or env)."
      },
      "DAEMON_PLUGIN_TURN_MS": {
        "type": "integer",
        "minimum": 100,
        "maximum": 120000,
        "description": "Mic capture window per voice turn in ms (default 6000)."
      },
      "DAEMON_PLUGIN_GAP_MS": {
        "type": "integer",
        "minimum": 50,
        "maximum": 3600000,
        "description": "Delay between the end of one turn and the start of the next while enabled (default 2000)."
      },
      "DAEMON_PLUGIN_SAMPLE_RATE_HZ": {
        "type": "integer",
        "minimum": 8000,
        "maximum": 192000,
        "description": "Capture rate negotiated with stt (default 16000)."
      },
      "DAEMON_PLUGIN_CHUNK_MS": {
        "type": "integer",
        "minimum": 10,
        "maximum": 1000,
        "description": "mic chunk duration in ms (default 100)."
      },
      "DAEMON_PLUGIN_STREAM_ID": {
        "type": "integer",
        "minimum": 1,
        "description": "AudioStreamChunk stream_id shared by stt_listen_* and mic_start (default 7)."
      },
      "DAEMON_PLUGIN_STT_TARGET": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$",
        "description": "Plugin slug serving stt_* — the mic streams to it and its VAD events arrive as plugin.<slug>.*. `stt` (default, standalone plugin) or `speech` (merged plugin). mic's MIC_PLUGIN_IPC_TARGETS must list the same slug."
      },
      "DAEMON_PLUGIN_TTS_PROVIDER": {
        "type": "string",
        "enum": [
          "sherpa",
          "openai",
          "elevenlabs"
        ],
        "description": "tts_synthesize provider (default sherpa — fully offline)."
      },
      "DAEMON_PLUGIN_TTS_VOICE": {
        "type": "string",
        "minLength": 1,
        "description": "Provider-specific voice id (default af_heart for sherpa)."
      },
      "DAEMON_PLUGIN_TTS_FORMAT": {
        "type": "string",
        "enum": [
          "wav",
          "mp3",
          "pcm",
          "opus",
          "aac",
          "flac",
          "ulaw"
        ],
        "description": "Synthesis format handed to sound_play (default wav)."
      },
      "DAEMON_PLUGIN_MAX_STEPS": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "agent goal_start max_steps budget per turn (default 6)."
      },
      "DAEMON_PLUGIN_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 500,
        "description": "Per-call timeout for mic/stt/tts/sound round-trips (default 30000)."
      },
      "DAEMON_PLUGIN_GOAL_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1000,
        "description": "Timeout for the agent goal_start call — LLM loops run long (default 120000)."
      }
    },
    "additionalProperties": true
  }
}
