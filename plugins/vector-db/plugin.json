{
  "plugin_id": "vector-db",
  "version": "0.1.0",
  "permissions": ["PERMISSION_STORAGE", "PERMISSION_EVENT_PUBLISH"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "vector-db",
  "events": [],
  "files": ["vector-db", "plugin.json"],
  "actions": [
    {
      "name": "vec_upsert",
      "description": "Store or replace one document in a collection: supply text (embedded via the ai plugin) or a precomputed vector, plus optional metadata. Overwrites any document already under that id.",
      "risk": "medium",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1, "description": "Collection name, per-caller namespace." },
          "id": { "type": "string", "minLength": 1, "description": "Document id within collection." },
          "text": { "type": "string", "description": "Text to embed (optional if vector provided). 1..10000 chars." },
          "vector": { "type": "array", "items": { "type": "number" }, "description": "Precomputed L2-normalizable vector (optional if text provided)." },
          "metadata": { "type": "object", "description": "Arbitrary JSON metadata.", "additionalProperties": true }
        },
        "required": ["collection", "id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "id": { "type": "string" },
          "dim": { "type": "integer" }
        },
        "required": ["ok", "id", "dim"],
        "additionalProperties": false
      }
    },
    {
      "name": "vec_query",
      "description": "Semantic search in a collection: query text (embedded on the fly) or a precomputed vector, top_k hits with scores, optional exact-match metadata filter. Read-only.",
      "risk": "low",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "description": "Query text to embed." },
          "vector": { "type": "array", "items": { "type": "number" }, "description": "Precomputed query vector." },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
          "include_vector": { "type": "boolean", "default": false, "description": "Include stored vectors in results." },
          "filter": { "type": "object", "description": "Metadata filter (exact match on top-level keys).", "additionalProperties": true }
        },
        "required": ["collection"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "score": { "type": "number" },
                "text": { "type": "string" },
                "metadata": { "type": "object" },
                "vector": { "type": "array", "items": { "type": "number" } }
              },
              "required": ["id", "score"]
            }
          }
        },
        "required": ["results"],
        "additionalProperties": false
      }
    },
    {
      "name": "vec_get",
      "description": "Fetch one stored document by collection and id, with its metadata. Read-only.",
      "risk": "low",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["collection", "id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": { "type": "boolean" },
          "id": { "type": "string" },
          "text": { "type": "string" },
          "vector": { "type": "array", "items": { "type": "number" } },
          "metadata": { "type": "object" },
          "dim": { "type": "integer" }
        },
        "required": ["found"],
        "additionalProperties": true
      }
    },
    {
      "name": "vec_delete",
      "description": "Delete one document from a collection by id. Irreversible — the vector and its metadata are gone, and re-adding needs the original text.",
      "risk": "high",
      "requires_confirmation": true,
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["collection", "id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": { "type": "boolean" }
        },
        "required": ["deleted"],
        "additionalProperties": false
      }
    },
    {
      "name": "vec_list",
      "description": "List the caller's collections, optionally filtered by name prefix. Read-only.",
      "risk": "low",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "prefix": { "type": "string", "default": "", "description": "Filter collections by prefix." }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "collections": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["collections"],
        "additionalProperties": false
      }
    },
    {
      "name": "vec_stats",
      "description": "Report a collection's document count, vector dimension and storage size. Read-only.",
      "risk": "low",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1 }
        },
        "required": ["collection"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "dim": { "type": "integer" }
        },
        "required": ["count", "dim"],
        "additionalProperties": false
      }
    },
    {
      "name": "vec_upsert_batch",
      "description": "Store or replace many documents in one collection in a single call. Same overwrite semantics as vec_upsert, applied per id.",
      "risk": "medium",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "collection": { "type": "string", "minLength": 1 },
          "docs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "vector": { "type": "array", "items": { "type": "number" } },
                "metadata": { "type": "object", "additionalProperties": true }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["collection", "docs"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "count": { "type": "integer" },
          "dim": { "type": "integer" }
        },
        "required": ["ok", "count", "dim"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "VECTOR_DB_DATA_DIR": { "type": "string", "description": "Directory holding per-caller .db files. Required." },
      "VECTOR_DB_POOL_SIZE": { "type": "integer", "minimum": 1, "default": 4 },
      "VECTOR_DB_BUSY_TIMEOUT_MS": { "type": "integer", "minimum": 0, "default": 5000 },
      "VECTOR_DB_MAX_RESPONSE_BYTES": { "type": "integer", "minimum": 1, "default": 4194304 },
      "VECTOR_DB_MAX_DB_BYTES": { "type": "integer", "minimum": 0, "default": 268435456 },
      "VECTOR_DB_DEFAULT_DIM": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 384 },
      "VECTOR_DB_EMBED_MODEL": { "type": "string", "description": "If set, enables forwarding text → ai embedding (e.g. nomic-embed-text). Empty = offline fake." },
      "VECTOR_DB_EMBED_PROVIDER": { "type": "string", "default": "openai", "description": "Provider for ai embedding." },
      "VECTOR_DB_EMBED_BASE_URL": { "type": "string", "description": "Base URL for embeddings, e.g. http://localhost:11434/v1 for Ollama." },
      "VECTOR_DB_EMBED_API_KEY_ENV": { "type": "string", "description": "Env var name for api key, must be in AI_PLUGIN_ALLOWED_KEY_ENVS." },
      "VECTOR_DB_EMBED_TIMEOUT_MS": { "type": "integer", "minimum": 1, "maximum": 30000, "default": 10000 },
      "VECTOR_DB_EMBED_FALLBACK": { "type": "string", "enum": ["fake","error"], "default": "error", "description": "When ai embedding fails: fake → silent fake fallback (offline), error → fail the request." }
    },
    "required": ["VECTOR_DB_DATA_DIR"],
    "additionalProperties": true
  }
}
