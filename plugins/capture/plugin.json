{
  "plugin_id": "capture",
  "version": "0.1.0",
  "permissions": ["PERMISSION_SCREEN"],
  "kernel_compatibility_range": { "min": "0.1.0", "max": "*" },
  "binary": "capture",
  "events": [],
  "files": ["capture", "plugin.json"],
  "actions": [
    {
      "name": "capture_screenshot",
      "description": "Take a screenshot — the whole screen by default, an interactive selection with region='select', or a fixed {x,y,w,h} box — and write it to the capture directory, returning the path. Captures whatever is on screen at that moment, including anything private left open.",
      "risk": "high",
      "requires_confirmation": true,
      "permission": "PERMISSION_SCREEN",
      "input": {
        "type": "object",
        "properties": {
          "region": {
            "description": "'full' (default), 'select' (interactive), or {x,y,w,h}."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "format": { "type": "string" }
        }
      }
    },
    {
      "name": "capture_record_start",
      "description": "Start recording the screen to a file (whole screen or a fixed region; default cap 30 minutes) and return a recording_id. Runs unattended until stopped or the cap expires — a continuous record of everything displayed.",
      "risk": "high",
      "requires_confirmation": true,
      "permission": "PERMISSION_SCREEN",
      "input": {
        "type": "object",
        "properties": {
          "region": { "description": "'full' (default) or {x,y,w,h}." },
          "max_duration_ms": { "type": "integer", "description": "Default 1800000 (30 min)." }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "recording_id": { "type": "string" } }
      }
    },
    {
      "name": "capture_record_stop",
      "description": "Stop a screen recording by recording_id and finalize its file, returning the path.",
      "risk": "medium",
      "permission": "PERMISSION_SCREEN",
      "input": {
        "type": "object",
        "properties": { "recording_id": { "type": "string" } },
        "required": ["recording_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "duration_ms": { "type": "integer" }
        }
      }
    },
    {
      "name": "capture_ocr",
      "description": "Extract text from an image, given a path or base64 bytes (tesseract, fully offline; lang defaults to eng). Read-only with respect to the screen.",
      "risk": "low",
      "permission": "PERMISSION_SCREEN",
      "input": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "base64": { "type": "string" },
          "lang": { "type": "string", "description": "Default 'eng'." }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "text": { "type": "string" } }
      }
    },
    {
      "name": "capture_status",
      "description": "Report capture backend availability and any recording in progress. Read-only.",
      "risk": "low",
      "permission": "PERMISSION_SCREEN",
      "input": { "type": "object", "properties": {}, "additionalProperties": true },
      "output": {
        "type": "object",
        "properties": {
          "session_type": { "type": "string" },
          "screenshot_backend": { "type": ["string", "null"] },
          "record_backend": { "type": ["string", "null"] },
          "ocr_available": { "type": "boolean" },
          "portal_available": { "type": "boolean" }
        }
      }
    }
  ]
}
