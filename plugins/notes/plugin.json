{
  "plugin_id": "notes",
  "version": "0.1.0",
  "permissions": ["PERMISSION_STORAGE", "PERMISSION_EVENT_PUBLISH"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "notes",
  "events": [],
  "files": ["notes", "plugin.json"],
  "actions": [
    {
      "name": "note_create",
      "description": "Create a new note with optional title, body (up to 256 KiB), and up to 32 tags — at least one of title/body must be non-empty. Returns the assigned id and full note; use note_update to edit an existing note instead of creating a duplicate.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512,
            "description": "Note title. Optional, but at least one of title/body must be non-empty."
          },
          "body": {
            "type": "string",
            "maxLength": 262144,
            "description": "Note body text. Optional, but at least one of title/body must be non-empty."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 32,
            "description": "Tags: trimmed, empties dropped, deduplicated, each ≤64 bytes. Optional."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Assigned note id (monotonic counter)." },
          "note": { "$ref": "#/$defs/note" }
        },
        "required": ["id", "note"],
        "additionalProperties": false
      }
    },
    {
      "name": "note_get",
      "description": "Fetch one note by its exact id. Returns found=false (not an error) if no such note exists. Use note_list to search/browse instead of guessing ids.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": { "type": "boolean" },
          "note": { "$ref": "#/$defs/note" }
        },
        "required": ["found"],
        "additionalProperties": false
      }
    },
    {
      "name": "note_list",
      "description": "List/browse notes, newest-updated first, optionally filtered to one tag; limit (default 100, max 500) and offset (default 0) paginate. Returns total count after filtering. Use note_get when you already know the id.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "description": "Only notes carrying this tag. Optional; empty = all notes."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Page size."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Skip this many notes after filtering/sorting."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": { "$ref": "#/$defs/note" },
            "description": "Sorted newest-first (updated_at_ms desc, id desc tie-break)."
          },
          "total": {
            "type": "integer",
            "description": "Count after filtering, before pagination."
          }
        },
        "required": ["notes", "total"],
        "additionalProperties": false
      }
    },
    {
      "name": "note_update",
      "description": "Edit an existing note by id: title, body, and/or tags each replace the prior value only when present (tags replaces the whole set, not a merge). Errors if the note doesn't exist, or if the result would leave both title and body empty.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": {
            "type": "string",
            "maxLength": 512,
            "description": "Replaces the title when present."
          },
          "body": {
            "type": "string",
            "maxLength": 262144,
            "description": "Replaces the body when present."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 32,
            "description": "Replaces the whole tag set when present."
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "updated": { "type": "boolean" },
          "note": { "$ref": "#/$defs/note" }
        },
        "required": ["updated", "note"],
        "additionalProperties": false
      }
    },
    {
      "name": "note_delete",
      "description": "Permanently delete a note by id — no trash, no undo. Returns deleted=false (not an error) if the note didn't exist, so it's safe to call idempotently.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "True only when the note existed and was removed."
          }
        },
        "required": ["deleted"],
        "additionalProperties": false
      }
    }
  ],
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "created_at_ms": { "type": "integer", "description": "Unix time in milliseconds." },
        "updated_at_ms": { "type": "integer", "description": "Unix time in milliseconds." }
      },
      "required": ["id", "title", "body", "tags", "created_at_ms", "updated_at_ms"],
      "additionalProperties": false
    }
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "NOTES_PLUGIN_DB_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "default": 5000,
        "description": "Timeout for each database IPC call."
      }
    },
    "additionalProperties": true
  }
}
