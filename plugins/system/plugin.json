{
  "plugin_id": "system",
  "version": "0.1.0",
  "permissions": [
    "PERMISSION_SYSTEM"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "system",
  "events": [],
  "files": [
    "system",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "sys_info",
      "description": "Get static host identity: hostname, OS name/version, kernel version, and CPU architecture (x86_64/aarch64/x86/arm). No parameters.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": [
              "string",
              "null"
            ]
          },
          "os": {
            "type": [
              "string",
              "null"
            ],
            "description": "Long OS name, e.g. 'Arch Linux'."
          },
          "os_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "kernel": {
            "type": [
              "string",
              "null"
            ]
          },
          "arch": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "x86_64",
              "aarch64",
              "x86",
              "arm"
            ]
          }
        },
        "required": [
          "hostname",
          "os",
          "os_version",
          "kernel",
          "arch"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_battery",
      "description": "Get battery charge percent, state (charging/discharging/empty/full/unknown), and estimated seconds to empty/full via UPower. Errors ERR_SYS_NOT_SUPPORTED on hosts with no battery.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "number"
          },
          "state": {
            "type": "string",
            "enum": [
              "unknown",
              "charging",
              "discharging",
              "empty",
              "full"
            ]
          },
          "time_to_empty_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "time_to_full_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "percent",
          "state",
          "time_to_empty_s",
          "time_to_full_s"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_procs",
      "description": "Get overall system load: running process count, 1/5/15-minute load averages, and total/used memory in MB. Aggregate numbers only — does not list individual processes or their names.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "process_count": {
            "type": "integer",
            "minimum": 0
          },
          "load_avg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "1/5/15-minute load averages."
          },
          "memory_total_mb": {
            "type": "integer",
            "minimum": 0
          },
          "memory_used_mb": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "process_count",
          "load_avg",
          "memory_total_mb",
          "memory_used_mb"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_volume",
      "description": "Get the default audio sink's current volume percent and mute state (via wpctl/PipeWire, falling back to pactl/PulseAudio).",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_volume_set",
      "description": "Set the default audio sink's volume to an exact percent (integer 0..100, required); returns the resulting percent and mute state. Reversible speaker/headphone volume change.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_volume_mute",
      "description": "Mute, unmute, or toggle the default audio sink; mode is required (on/off/toggle — no implicit current-state guessing). Returns the resulting percent and mute state.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "toggle"
            ],
            "description": "Explicit target state; 'toggle' flips the current one."
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer"
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_brightness",
      "description": "Get the screen backlight's current brightness percent (sysfs backlight device).",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_brightness_set",
      "description": "Set the screen backlight brightness to an exact percent (integer 0..100, required); 0 clamps to the device's minimum non-blanking step so the screen never goes fully black. Reversible display change.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "0 clamps to the device's minimum non-blanking step."
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_lock",
      "description": "Immediately lock the current desktop session (org.freedesktop.ScreenSaver, falling back to loginctl lock-session), requiring the user's password/PIN to get back in. No parameters, no warning, no undo — only use when the user explicitly asked to lock the screen.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_power_profile",
      "description": "Get the active power-profiles-daemon profile (performance/balanced/power-saver) and the list of profiles this host supports. Errors ERR_SYS_NOT_SUPPORTED when power-profiles-daemon isn't running (e.g. TLP-only hosts).",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "profile",
          "available"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_power_profile_set",
      "description": "Switch the active power-profiles-daemon profile to performance, balanced, or power-saver (required, exact match); returns the resulting profile and available list. Reversible tradeoff between speed and battery life.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "performance",
              "balanced",
              "power-saver"
            ]
          }
        },
        "required": [
          "profile"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "profile",
          "available"
        ],
        "additionalProperties": true
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {},
    "additionalProperties": true
  }
}
