{
  "plugin_id": "agent",
  "version": "0.1.4",
  "permissions": [
    "PERMISSION_STORAGE",
    "PERMISSION_EVENT_PUBLISH"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "agent",
  "events": [],
  "files": [
    "agent",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "goal_start",
      "input": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "description": "What the agent should accomplish (1..4000 chars)."
          },
          "context": {
            "type": "string",
            "description": "Optional background handed to the model alongside the goal."
          },
          "title": {
            "type": "string",
            "description": "Optional short label; defaults to the first 60 chars of goal."
          },
          "max_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Loop budget; default from AGENT_PLUGIN_MAX_STEPS (6)."
          },
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ],
            "description": "LLM provider override."
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI-compatible base URL override."
          },
          "model": {
            "type": "string",
            "description": "Model id override."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env-var-style key handle override (resolved by ai, vault-first)."
          },
          "agent_id": {
            "type": "string",
            "description": "Named ai profile; overrides provider/model/key resolution."
          },
          "max_tokens": {
            "type": "integer",
            "description": "Per-completion token cap override."
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "needs_confirmation",
              "declined",
              "max_steps_reached",
              "error"
            ]
          },
          "title": {
            "type": "string"
          },
          "final_answer": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pending_tool": {
            "type": "string",
            "description": "Set when status is needs_confirmation."
          },
          "max_steps": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "goal_get",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "goal": {
            "type": [
              "object",
              "null"
            ],
            "description": "Full GoalDoc incl. transcript when found."
          }
        },
        "required": [
          "found"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "goal_list",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Newest first."
          }
        },
        "required": [
          "total",
          "goals"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "goal_resume",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "approve": {
            "type": "boolean",
            "description": "true dispatches the pending tool and continues the loop; false declines the goal."
          }
        },
        "required": [
          "id",
          "approve"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "final_answer": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tools_list",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "requires_confirmation": {
                  "type": "boolean"
                },
                "timeout_ms": {
                  "type": "integer"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools_file_set": {
            "type": "boolean"
          }
        },
        "required": [
          "tools",
          "allowed_actions",
          "tools_file_set"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_forget",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Semantic query; the top similar fact above the score floor is deleted."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "forgotten": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "forgotten"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_clear",
      "input": {
        "type": "object",
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "cleared": {
            "type": "integer",
            "description": "Number of facts deleted."
          }
        },
        "required": [
          "cleared"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_list",
      "input": {
        "type": "object",
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "total",
          "facts"
        ],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "AGENT_PLUGIN_ALLOWED_ACTIONS": {
        "type": "string",
        "description": "Comma-separated exact action names the agent may dispatch. Default-deny: unset/empty = no tools."
      },
      "AGENT_PLUGIN_TOOLS_FILE": {
        "type": "string",
        "description": "Optional JSON file of curated tool specs; overrides manifest-discovered data per name."
      },
      "AGENT_PLUGIN_DISCOVERY": {
        "type": "string",
        "enum": [
          "kernel",
          "off"
        ],
        "description": "kernel (default) fills tool specs from registered manifests via read-only list_plugins/get_manifest commands."
      },
      "AGENT_PLUGIN_NATIVE_TOOLS": {
        "type": "string",
        "enum": [
          "auto",
          "on",
          "off"
        ],
        "default": "auto",
        "description": "Native tool-use passthrough: auto sends ai a tools param when the catalog is non-empty (degrades to the text protocol if the provider rejects it); on forces it; off is text-only."
      },
      "AGENT_PLUGIN_AI_PROVIDER": {
        "type": "string",
        "enum": [
          "anthropic",
          "openai"
        ],
        "description": "Default LLM provider for ai.chat_completion."
      },
      "AGENT_PLUGIN_AI_BASE_URL": {
        "type": "string",
        "description": "Default OpenAI-compatible base URL."
      },
      "AGENT_PLUGIN_AI_MODEL": {
        "type": "string",
        "description": "Default model id."
      },
      "AGENT_PLUGIN_AI_API_KEY_ENV": {
        "type": "string",
        "description": "Default env-var-style API-key handle (must be on ai's AI_PLUGIN_ALLOWED_KEY_ENVS)."
      },
      "AGENT_PLUGIN_AI_AGENT_ID": {
        "type": "string",
        "description": "Named ai profile; overrides the explicit provider/model/key defaults."
      },
      "AGENT_PLUGIN_AI_MAX_TOKENS": {
        "type": "integer",
        "minimum": 1,
        "description": "Default per-completion token cap (1024)."
      },
      "AGENT_PLUGIN_MAX_STEPS": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "Default loop budget per goal (6)."
      },
      "AGENT_PLUGIN_DB_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "description": "Per-call timeout for database IPC round-trips (5000)."
      },
      "AGENT_PLUGIN_MEMORY": {
        "type": "string",
        "enum": [
          "on",
          "off"
        ],
        "default": "off",
        "description": "Enable long-term memory over vector-db"
      },
      "AGENT_PLUGIN_MEMORY_COLLECTION": {
        "type": "string",
        "default": "agent-memory",
        "description": "Vector-db collection name for agent memory"
      }
    },
    "additionalProperties": true
  }
}
