{
  "plugin_id": "tasks",
  "version": "0.1.0",
  "permissions": [
    "PERMISSION_STORAGE",
    "PERMISSION_EVENT_PUBLISH"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "tasks",
  "events": [],
  "files": [
    "tasks",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "task_create",
      "description": "Create a new to-do task: title (required, 1-512 chars), optional notes (max 4096 chars), list name (max 64 chars), due_ms (unix ms deadline), and up to 32 tags. Returns the assigned id and full task, not done by default.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          },
          "list": {
            "type": "string",
            "maxLength": 64
          },
          "due_ms": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "$ref": "#/$defs/task"
          }
        },
        "required": [
          "id",
          "task"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_get",
      "description": "Fetch one task by its exact id. Returns found=false (not an error) if no such task exists. Use task_list to search/browse instead of guessing ids.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "task": {
            "$ref": "#/$defs/task"
          }
        },
        "required": [
          "found"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_list",
      "description": "List/search to-do tasks, newest-updated first: query does a case-insensitive substring match on title+notes, plus filters by list, tag, and status (pending/done/all, default pending-and-done both included when omitted); limit (default 100, max 500) and offset (default 0) paginate. Use task_get when you already know the id.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "list": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "all"
            ]
          },
          "tag": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/task"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "tasks",
          "total"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_update",
      "description": "Edit an existing task by id: title, notes, list, due_ms, tags, and/or done each replace the prior value only when present (tags replaces the whole set, not a merge; toggling done also stamps/clears done_at_ms). Errors if the task doesn't exist. Use task_done for a plain complete/reopen toggle.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          },
          "list": {
            "type": "string",
            "maxLength": 64
          },
          "due_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "updated": {
            "type": "boolean"
          },
          "task": {
            "$ref": "#/$defs/task"
          }
        },
        "required": [
          "updated",
          "task"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_done",
      "description": "Mark a task complete or, with done=false, reopen it (done defaults to true); stamps/clears done_at_ms accordingly. Reversible — call again with done=false to undo.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "done": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "done": {
            "type": "boolean"
          },
          "task": {
            "$ref": "#/$defs/task"
          }
        },
        "required": [
          "done",
          "task"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task_delete",
      "description": "Permanently delete a task by id — no trash, no undo. Returns deleted=false (not an error) if the task didn't exist, so it's safe to call idempotently.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "status",
      "description": "Plugin health check: version, uptime_ms, engine_ready, last_error, and counters. No parameters.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "uptime_ms": {
            "type": "integer"
          },
          "engine_ready": {
            "type": "boolean"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "counters": {
            "type": "object"
          }
        },
        "required": [
          "version",
          "uptime_ms",
          "engine_ready"
        ],
        "additionalProperties": true
      }
    }
  ],
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "list": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "boolean"
        },
        "due_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "created_at_ms": {
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer"
        },
        "done_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "notes",
        "list",
        "tags",
        "done",
        "due_ms",
        "created_at_ms",
        "updated_at_ms",
        "done_at_ms"
      ],
      "additionalProperties": false
    }
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "TASKS_PLUGIN_DB_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "default": 5000
      }
    },
    "additionalProperties": true
  }
}
