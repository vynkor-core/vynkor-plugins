{
  "plugin_id": "launcher",
  "version": "0.1.5",
  "permissions": [
    "launch"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "launcher",
  "events": [],
  "files": [
    "launcher",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "launch",
      "description": "Start an installed desktop application, a Steam game, or a command run inside a terminal emulator (tmux/kitty/alacritty/ghostty), by desktop-file id, Steam appid, or unique display name; provider=auto tries desktop then steam. `args` is appended as a plain argv list, never shell-interpreted. Use dry_run:true to preview the resolved command/argv without actually spawning it. This starts arbitrary programs on the machine.",
      "risk": "high",
      "requires_confirmation": true,
      "permission": "launch",
      "input": {
        "type": "object",
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1,
            "description": "App or game id to launch (desktop file id without .desktop, or Steam appid). For desktop, matches file stem; for Steam, numeric appid. Also accepts display name when unique. Resolve the exact id via launch_list first; display-name matching is unique-only and waydroid android-app entries are excluded."
          },
          "provider": {
            "type": "string",
            "enum": [
              "auto",
              "desktop",
              "steam",
              "tmux",
              "kitty",
              "alacritty",
              "ghostty"
            ],
            "default": "auto",
            "description": "Provider to use: auto tries desktop then steam, or force one. tmux/kitty/alacritty/ghostty launch the app_id as a command inside that terminal."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra argv to append after the launch command (never shell-interpreted)."
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "When true, validate and return what would be launched without spawning."
          }
        },
        "required": [
          "app_id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "launched": {
            "type": "boolean"
          },
          "dry_run": {
            "type": "boolean"
          },
          "provider": {
            "type": "string",
            "description": "Provider that handled the launch (desktop/steam)."
          },
          "app_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "description": "Binary invoked."
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Full argv that was (or would be) spawned."
          }
        },
        "required": [
          "launched",
          "provider",
          "app_id",
          "command",
          "argv"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "launch_list",
      "description": "List launchable apps/games/terminal targets (id, name, provider, exec/path) discovered by the given provider(s); query filters by substring over id/name, include_hidden also shows NoDisplay/Hidden desktop entries. Use this to find the exact `app_id` before calling launch.",
      "risk": "low",
      "permission": "launch",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "auto",
              "desktop",
              "steam",
              "tmux",
              "kitty",
              "alacritty",
              "ghostty"
            ],
            "default": "auto"
          },
          "query": {
            "type": "string",
            "description": "Case-insensitive substring filter over id and name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Max entries to return (default 100)."
          },
          "include_hidden": {
            "type": "boolean",
            "default": false,
            "description": "Include NoDisplay/Hidden desktop entries."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Launchable id (desktop stem or Steam appid)."
                },
                "name": {
                  "type": "string"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "desktop",
                    "steam",
                    "tmux",
                    "kitty",
                    "alacritty",
                    "ghostty"
                  ]
                },
                "exec": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Desktop Exec line (null for Steam)."
                },
                "path": {
                  "type": "string",
                  "description": "Source file path (desktop file or appmanifest)."
                }
              },
              "required": [
                "id",
                "name",
                "provider",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Providers that were scanned."
          }
        },
        "required": [
          "apps",
          "providers"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "launch_providers",
      "description": "List launch providers (desktop, steam, tmux, kitty, alacritty, ghostty) with availability and their configured scan roots — check before launch/launch_list to see what's usable on this machine.",
      "risk": "low",
      "permission": "launch",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "available": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "name",
            "available",
            "description"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "LAUNCHER_DESKTOP_DIRS": {
        "type": "string",
        "description": "Comma-separated desktop file dirs (default: XDG_DATA_DIRS/applications + ~/.local/share/applications)."
      },
      "LAUNCHER_STEAM_ROOTS": {
        "type": "string",
        "description": "Comma-separated Steam library roots (each must contain steamapps/). Default: ~/.steam/steam + ~/.local/share/Steam."
      },
      "LAUNCHER_ALLOWED_IDS": {
        "type": "string",
        "description": "Comma-separated allowlist of app ids that may be launched. Empty = allow all discovered."
      },
      "LAUNCHER_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "description": "Per-spawn timeout in ms (default 10000)."
      },
      "LAUNCHER_STEAM_BINARY": {
        "type": "string",
        "description": "Steam binary name (default steam)."
      },
      "LAUNCHER_DESKTOP_LAUNCHER": {
        "type": "string",
        "enum": [
          "auto",
          "gtk-launch",
          "gio",
          "xdg-open",
          "exec"
        ],
        "description": "Desktop launch method (default auto: gtk-launch \u2192 gio \u2192 exec)."
      },
      "LAUNCHER_CACHE_TTL_MS": {
        "type": "integer",
        "minimum": 1,
        "description": "In-memory scan cache TTL in ms (default 60000). 0 disables cache."
      }
    },
    "additionalProperties": true
  }
}
