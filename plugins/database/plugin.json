{
  "plugin_id": "database",
  "version": "0.1.0",
  "permissions": [
    "PERMISSION_STORAGE",
    "event_publish"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "database",
  "events": [],
  "files": [
    "database",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "db_get",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "KV key in the caller's own namespace."
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "value": {
            "description": "Decoded JSON value when found."
          }
        },
        "required": [
          "found"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "db_set",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "description": "Arbitrary JSON value; stored as JSON text, capped at DATABASE_PLUGIN_MAX_VALUE_BYTES."
          },
          "ttl_ms": {
            "type": "integer",
            "description": "Expire the key this many ms after set; absent = no expiry."
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_delete",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether the key existed and was removed."
          }
        },
        "required": [
          "deleted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_batch_get",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keys"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "key → decoded value; missing keys map to null."
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_query",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL against the caller's own database only. ATTACH is rejected."
          },
          "params": {
            "type": "array",
            "description": "Positional binds (?1, ?2, ...). Optional."
          }
        },
        "required": [
          "sql"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "description": "Rows for any statement that yields them (including INSERT ... RETURNING)."
          },
          "rows_affected": {
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "rows_affected"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_incr",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "delta": {
            "type": "integer",
            "default": 1,
            "description": "negative decrements"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_keys",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "default": "",
            "description": "only keys starting with this"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keys"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_append",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "description": "Arbitrary JSON value appended to the array stored at key."
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "length": {
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "length"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db_patch",
      "permission": "storage",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "SQLite JSON path, e.g. $.a.b or $[0]"
          },
          "value": {
            "description": "Arbitrary JSON value to set at the path."
          }
        },
        "required": [
          "key",
          "path",
          "value"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "value": {
            "description": "The full updated JSON value."
          }
        },
        "required": [
          "ok",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "status",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "uptime_ms": {
            "type": "integer"
          },
          "engine_ready": {
            "type": "boolean"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "counters": {
            "type": "object"
          }
        },
        "required": [
          "version",
          "uptime_ms",
          "engine_ready"
        ],
        "additionalProperties": true
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "DATABASE_PLUGIN_DATA_DIR": {
        "type": "string",
        "description": "Directory holding per-caller .db files. Required."
      },
      "DATABASE_PLUGIN_POOL_SIZE": {
        "type": "integer",
        "minimum": 1,
        "default": 4,
        "description": "Connections per caller pool."
      },
      "DATABASE_PLUGIN_BUSY_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 0,
        "default": 5000,
        "description": "SQLite busy timeout."
      },
      "DATABASE_PLUGIN_MAX_VALUE_BYTES": {
        "type": "integer",
        "minimum": 1,
        "default": 1048576,
        "description": "db_set value size cap. Oversized values are rejected, never truncated."
      },
      "DATABASE_PLUGIN_MAX_RESPONSE_BYTES": {
        "type": "integer",
        "minimum": 1,
        "default": 4194304,
        "description": "db_query/db_batch_get result size cap."
      },
      "DATABASE_PLUGIN_MAX_DB_BYTES": {
        "type": "integer",
        "minimum": 0,
        "default": 268435456,
        "description": "Hard per-caller disk quota enforced via PRAGMA max_page_count. 0 disables."
      }
    },
    "required": [
      "DATABASE_PLUGIN_DATA_DIR"
    ],
    "additionalProperties": true
  }
}
