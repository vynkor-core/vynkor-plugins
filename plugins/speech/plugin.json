{
  "plugin_id": "speech",
  "version": "0.1.0",
  "permissions": [
    "PERMISSION_AUDIO_STREAM",
    "PERMISSION_EVENT_PUBLISH",
    "PERMISSION_IPC_SEND",
    "network",
    "secrets"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "speech",
  "events": [],
  "files": [
    "speech",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "tts_synthesize",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai",
              "elevenlabs"
            ],
            "description": "sherpa = in-process local ONNX; openai/elevenlabs = cloud via network. Required."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N; openai: documented voice id; elevenlabs: your account's voice id."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env var name the tts process reads at call time (never a literal key); must be on TTS_PLUGIN_ALLOWED_KEY_ENVS. Required for cloud providers, ignored for sherpa."
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "opus",
              "aac",
              "flac",
              "ulaw"
            ],
            "description": "Per-provider subset: sherpa wav|pcm|mp3 (default wav); openai mp3|wav|pcm|opus|aac|flac (default mp3); elevenlabs mp3|pcm|ulaw (default mp3)."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional per-provider override (defaults: https://api.openai.com/v1, https://api.elevenlabs.io)."
          },
          "model": {
            "type": "string",
            "description": "Optional per-provider model override (defaults: gpt-4o-mini-tts, eleven_multilingual_v2)."
          }
        },
        "required": [
          "provider",
          "text",
          "voice"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "opus",
              "aac",
              "flac",
              "ulaw"
            ]
          },
          "sample_rate_hz": {
            "type": "integer",
            "description": "0 when the container can't carry it (mp3/opus/aac/flac from a cloud provider)."
          },
          "num_channels": {
            "type": "integer",
            "description": "0 when the container can't carry it."
          },
          "duration_seconds": {
            "type": "number",
            "description": "0 when the container can't carry it."
          },
          "audio_base64": {
            "type": "string",
            "description": "Base64-encoded audio bytes."
          }
        },
        "required": [
          "format",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "audio_base64"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tts_voices",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai",
              "elevenlabs"
            ],
            "description": "elevenlabs is rejected: voices are per-account."
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "tts_speak",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa"
            ],
            "description": "tts_speak is sherpa-only: streaming needs a PCM source, which only the local provider has."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Peer to stream the Opus audio to, e.g. device.phone.speaker. Required."
          },
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Echoed in every AudioStreamChunk; lets the receiver demux concurrent streams."
          },
          "sample_rate_hz": {
            "type": "integer",
            "enum": [
              8000,
              12000,
              16000,
              24000,
              48000
            ],
            "description": "Advertised stream rate. Defaults to the model's output rate; must be an Opus-supported rate."
          },
          "bitrate": {
            "type": "integer",
            "minimum": 6000,
            "maximum": 510000,
            "default": 32000,
            "description": "Opus encode bitrate in bits/second; 0 = codec default."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          }
        },
        "required": [
          "provider",
          "text",
          "voice",
          "target"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "enum": [
              "opus"
            ]
          },
          "stream_id": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          },
          "sample_rate_hz": {
            "type": "integer"
          },
          "num_channels": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number"
          },
          "packets": {
            "type": "integer",
            "description": "Number of Opus packets streamed."
          }
        },
        "required": [
          "codec",
          "stream_id",
          "target",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "packets"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tts_speak_stream",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa"
            ],
            "description": "tts_speak is sherpa-only: streaming needs a PCM source, which only the local provider has."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Peer to stream the Opus audio to, e.g. device.phone.speaker. Required."
          },
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Echoed in every AudioStreamChunk; lets the receiver demux concurrent streams."
          },
          "sample_rate_hz": {
            "type": "integer",
            "enum": [
              8000,
              12000,
              16000,
              24000,
              48000
            ],
            "description": "Advertised stream rate. Defaults to the model's output rate; must be an Opus-supported rate."
          },
          "bitrate": {
            "type": "integer",
            "minimum": 6000,
            "maximum": 510000,
            "default": 32000,
            "description": "Opus encode bitrate in bits/second; 0 = codec default."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          }
        },
        "required": [
          "provider",
          "text",
          "voice",
          "target"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "enum": [
              "opus"
            ]
          },
          "stream_id": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          },
          "sample_rate_hz": {
            "type": "integer"
          },
          "num_channels": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number"
          },
          "packets": {
            "type": "integer",
            "description": "Number of Opus packets streamed."
          }
        },
        "required": [
          "codec",
          "stream_id",
          "target",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "packets"
        ],
        "additionalProperties": false
      },
      "description": "Like tts_speak, but the text is split into sentences and each is synthesized+streamed in turn — first audio after one phrase; end_of_stream only on the final packet."
    },
    {
      "name": "stt_listen_start",
      "input": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Matches the stream_id of the inbound AudioStreamChunk envelopes."
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "description": "PCM rate of the inbound stream. Required."
          },
          "num_channels": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Channel count of the inbound stream; downmixed to mono."
          },
          "language": {
            "type": "string",
            "description": "Optional ISO-639-1 hint applied at transcription time."
          }
        },
        "required": [
          "sample_rate_hz"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "listening"
            ]
          }
        },
        "required": [
          "stream_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_listen_stop",
      "input": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "stream_id",
          "text",
          "language",
          "duration_seconds",
          "model"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_transcribe",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai"
            ],
            "description": "sherpa = in-process local ONNX; openai = cloud via network. Required."
          },
          "audio_base64": {
            "type": "string",
            "description": "Base64 of the audio bytes, <= 25 MiB after decoding. Required."
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "ogg"
            ],
            "description": "sherpa: wav (default) | pcm (requires sample_rate_hz + num_channels); openai: wav (default) | mp3 | ogg."
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "description": "Required for sherpa with pcm format; ignored otherwise."
          },
          "num_channels": {
            "type": "integer",
            "minimum": 1,
            "description": "Required for sherpa with pcm format; ignored otherwise."
          },
          "language": {
            "type": "string",
            "description": "Optional ISO-639-1 hint, e.g. \"de\". Echoed back in the response."
          },
          "prompt": {
            "type": "string",
            "maxLength": 1000,
            "description": "Optional Whisper-style context hint (openai only)."
          },
          "temperature": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Optional (openai only)."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env var name the stt process reads at call time (never a literal key); must be on STT_PLUGIN_ALLOWED_KEY_ENVS. Required for openai, ignored for sherpa."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional per-provider override (default https://api.openai.com/v1)."
          },
          "model": {
            "type": "string",
            "description": "Optional per-provider model override (default whisper-1; must be one of the ids stt_models lists for openai)."
          }
        },
        "required": [
          "provider",
          "audio_base64"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Empty string when unknown."
          },
          "duration_seconds": {
            "type": "number",
            "description": "0 when it can't be derived from the container format."
          },
          "model": {
            "type": "string",
            "description": "Provider model id (sherpa:<family> for local)."
          }
        },
        "required": [
          "text",
          "language",
          "duration_seconds",
          "model"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_models",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai"
            ]
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "status",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "uptime_ms": {
            "type": "integer"
          },
          "engine_ready": {
            "type": "boolean"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "counters": {
            "type": "object"
          }
        },
        "required": [
          "version",
          "uptime_ms",
          "engine_ready"
        ],
        "additionalProperties": true
      }
    }
  ],
  "$defs": {},
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": true,
    "description": "speech reads the union of the standalone plugins' env vars: every TTS_PLUGIN_* and STT_PLUGIN_* knob applies unchanged (model dirs, voices, VAD, key allowlists, TTS_PLUGIN_IPC_TARGETS)."
  }
}
