{
  "plugin_id": "stt",
  "version": "0.1.0",
  "permissions": [
    "network",
    "secrets",
    "PERMISSION_AUDIO_STREAM",
    "PERMISSION_EVENT_PUBLISH"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "stt",
  "events": [],
  "files": [
    "stt",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "stt_listen_start",
      "description": "Begin transcribing an inbound live audio stream (matched by stream_id, at sample_rate_hz). Open-ended capture of whatever the far-end microphone hears until stt_listen_stop.",
      "risk": "high",
      "requires_confirmation": true,
      "input": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Matches the stream_id of the inbound AudioStreamChunk envelopes."
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "description": "PCM rate of the inbound stream. Required."
          },
          "num_channels": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Channel count of the inbound stream; downmixed to mono."
          },
          "language": {
            "type": "string",
            "description": "Optional ISO-639-1 hint applied at transcription time."
          }
        },
        "required": [
          "sample_rate_hz"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "listening"
            ]
          }
        },
        "required": [
          "stream_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_listen_stop",
      "description": "Stop a live transcription session started by stt_listen_start and return its final transcript.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "stream_id",
          "text",
          "language",
          "duration_seconds",
          "model"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_transcribe",
      "description": "Transcribe one audio blob, passed as base64 (<= 25 MiB decoded) or read from an absolute file_path: provider (sherpa local, openai cloud), format, optional language/prompt/model. With provider=openai the audio leaves this machine.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai"
            ],
            "description": "sherpa = in-process local ONNX; openai = cloud via network. Required."
          },
          "audio_base64": {
            "type": "string",
            "description": "Base64 of the audio bytes, <= 25 MiB after decoding. Either audio_base64 or file_path required."
          },
          "file_path": {
            "type": "string",
            "description": "Absolute path to audio file on host (alternative to audio_base64, read directly by stt)."
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "ogg"
            ],
            "description": "sherpa: wav (default) | pcm (requires sample_rate_hz + num_channels); openai: wav (default) | mp3 | ogg."
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 1,
            "description": "Required for sherpa with pcm format; ignored otherwise."
          },
          "num_channels": {
            "type": "integer",
            "minimum": 1,
            "description": "Required for sherpa with pcm format; ignored otherwise."
          },
          "language": {
            "type": "string",
            "description": "Optional ISO-639-1 hint, e.g. \"de\". Echoed back in the response."
          },
          "prompt": {
            "type": "string",
            "maxLength": 1000,
            "description": "Optional Whisper-style context hint (openai only)."
          },
          "temperature": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Optional (openai only)."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env var name the stt process reads at call time (never a literal key); must be on STT_PLUGIN_ALLOWED_KEY_ENVS. Required for openai, ignored for sherpa."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional per-provider override (default https://api.openai.com/v1)."
          },
          "model": {
            "type": "string",
            "description": "Optional per-provider model override (default whisper-1; must be one of the ids stt_models lists for openai)."
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Empty string when unknown."
          },
          "duration_seconds": {
            "type": "number",
            "description": "0 when it can't be derived from the container format."
          },
          "model": {
            "type": "string",
            "description": "Provider model id (sherpa:<family> for local)."
          }
        },
        "required": [
          "text",
          "language",
          "duration_seconds",
          "model"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stt_models",
      "description": "List the transcription models available for a provider. Read-only.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai"
            ]
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "STT_PLUGIN_ALLOWED_KEY_ENVS": {
        "type": "string",
        "description": "Required for the cloud provider, default-deny: comma-separated allowlist of env var names a caller's api_key_env may reference."
      },
      "STT_PLUGIN_LOCAL_MODEL_DIR": {
        "type": "string",
        "description": "Required for sherpa: directory with the ONNX model files."
      },
      "STT_PLUGIN_LOCAL_MODEL_TYPE": {
        "type": "string",
        "enum": [
          "transducer",
          "whisper"
        ],
        "description": "Required for sherpa."
      },
      "STT_PLUGIN_LOCAL_NUM_THREADS": {
        "type": "integer",
        "minimum": 1,
        "default": 2
      },
      "STT_PLUGIN_LOCAL_LANGUAGE": {
        "type": "string",
        "default": "en",
        "description": "Whisper family only."
      }
    },
    "additionalProperties": true
  }
}
