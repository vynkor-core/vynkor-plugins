{
  "plugin_id": "tts",
  "version": "0.1.1",
  "permissions": [
    "network",
    "PERMISSION_AUDIO_STREAM",
    "PERMISSION_IPC_SEND",
    "secrets"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "tts",
  "events": [],
  "files": [
    "tts",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "tts_synthesize",
      "description": "Synthesize speech and return the audio bytes: provider (sherpa = local in-process ONNX, openai/elevenlabs = cloud), text, voice, optional format/speed/model/base_url. Cloud providers send the text off this machine; sherpa does not.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai",
              "elevenlabs"
            ],
            "description": "sherpa = in-process local ONNX; openai/elevenlabs = cloud via network. Required."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N; openai: documented voice id; elevenlabs: your account's voice id."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env var name the tts process reads at call time (never a literal key); must be on TTS_PLUGIN_ALLOWED_KEY_ENVS. Required for cloud providers, ignored for sherpa."
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "opus",
              "aac",
              "flac",
              "ulaw"
            ],
            "description": "Per-provider subset: sherpa wav|pcm|mp3 (default wav); openai mp3|wav|pcm|opus|aac|flac (default mp3); elevenlabs mp3|pcm|ulaw (default mp3)."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional per-provider override (defaults: https://api.openai.com/v1, https://api.elevenlabs.io)."
          },
          "model": {
            "type": "string",
            "description": "Optional per-provider model override (defaults: gpt-4o-mini-tts, eleven_multilingual_v2)."
          }
        },
        "required": [
          "provider",
          "text",
          "voice"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3",
              "opus",
              "aac",
              "flac",
              "ulaw"
            ]
          },
          "sample_rate_hz": {
            "type": "integer",
            "description": "0 when the container can't carry it (mp3/opus/aac/flac from a cloud provider)."
          },
          "num_channels": {
            "type": "integer",
            "description": "0 when the container can't carry it."
          },
          "duration_seconds": {
            "type": "number",
            "description": "0 when the container can't carry it."
          },
          "audio_base64": {
            "type": "string",
            "description": "Base64-encoded audio bytes."
          }
        },
        "required": [
          "format",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "audio_base64"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tts_voices",
      "description": "List the voices available for a provider (sherpa or openai; elevenlabs is rejected because its voices are per-account). Read-only.",
      "risk": "low",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa",
              "openai",
              "elevenlabs"
            ],
            "description": "elevenlabs is rejected: voices are per-account."
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "tts_speak",
      "description": "Synthesize and stream Opus audio straight to a peer (e.g. device.phone.speaker) instead of returning bytes — it comes out of a real speaker in the room. sherpa-only: streaming needs a local PCM source.",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa"
            ],
            "description": "tts_speak is sherpa-only: streaming needs a PCM source, which only the local provider has."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Peer to stream the Opus audio to, e.g. device.phone.speaker. Required."
          },
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Echoed in every AudioStreamChunk; lets the receiver demux concurrent streams."
          },
          "sample_rate_hz": {
            "type": "integer",
            "enum": [
              8000,
              12000,
              16000,
              24000,
              48000
            ],
            "description": "Advertised stream rate. Defaults to the model's output rate; must be an Opus-supported rate."
          },
          "bitrate": {
            "type": "integer",
            "minimum": 6000,
            "maximum": 510000,
            "default": 32000,
            "description": "Opus encode bitrate in bits/second; 0 = codec default."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          }
        },
        "required": [
          "provider",
          "text",
          "voice",
          "target"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "enum": [
              "opus"
            ]
          },
          "stream_id": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          },
          "sample_rate_hz": {
            "type": "integer"
          },
          "num_channels": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number"
          },
          "packets": {
            "type": "integer",
            "description": "Number of Opus packets streamed."
          }
        },
        "required": [
          "codec",
          "stream_id",
          "target",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "packets"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tts_speak_stream",
      "risk": "medium",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "sherpa"
            ],
            "description": "tts_speak is sherpa-only: streaming needs a PCM source, which only the local provider has."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Peer to stream the Opus audio to, e.g. device.phone.speaker. Required."
          },
          "stream_id": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Echoed in every AudioStreamChunk; lets the receiver demux concurrent streams."
          },
          "sample_rate_hz": {
            "type": "integer",
            "enum": [
              8000,
              12000,
              16000,
              24000,
              48000
            ],
            "description": "Advertised stream rate. Defaults to the model's output rate; must be an Opus-supported rate."
          },
          "bitrate": {
            "type": "integer",
            "minimum": 6000,
            "maximum": 510000,
            "default": 32000,
            "description": "Opus encode bitrate in bits/second; 0 = codec default."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          }
        },
        "required": [
          "provider",
          "text",
          "voice",
          "target"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "codec": {
            "type": "string",
            "enum": [
              "opus"
            ]
          },
          "stream_id": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          },
          "sample_rate_hz": {
            "type": "integer"
          },
          "num_channels": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number"
          },
          "packets": {
            "type": "integer",
            "description": "Number of Opus packets streamed."
          }
        },
        "required": [
          "codec",
          "stream_id",
          "target",
          "sample_rate_hz",
          "num_channels",
          "duration_seconds",
          "packets"
        ],
        "additionalProperties": false
      },
      "description": "Like tts_speak, but the text is split into sentences and each is synthesized+streamed in turn — first audio after one phrase; end_of_stream only on the final packet."
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "TTS_PLUGIN_ALLOWED_KEY_ENVS": {
        "type": "string",
        "description": "Required for cloud providers, default-deny: comma-separated allowlist of env var names a caller's api_key_env may reference."
      },
      "TTS_PLUGIN_LOCAL_MODEL_DIR": {
        "type": "string",
        "description": "Required for sherpa: directory with the ONNX model files."
      },
      "TTS_PLUGIN_LOCAL_MODEL_TYPE": {
        "type": "string",
        "enum": [
          "kokoro",
          "piper"
        ],
        "description": "Required for sherpa."
      },
      "TTS_PLUGIN_LOCAL_NUM_THREADS": {
        "type": "integer",
        "minimum": 1,
        "default": 2
      },
      "TTS_PLUGIN_KOKORO_LEXICON": {
        "type": "string",
        "description": "Optional comma-separated lexicon list; default auto-detects every lexicon-*.txt in the model dir."
      },
      "TTS_PLUGIN_IPC_TARGETS": {
        "type": "string",
        "description": "Required for tts_speak: comma-separated ipc_targets allowlist for streaming (e.g. device.phone.speaker). Default-deny — unset means tts_speak can't stream anywhere."
      }
    },
    "additionalProperties": true
  }
}
